{
    "manifest_version": 3,

    "name": "HumanizeX",

    "version": "1.1",

    "description": "Detect and naturally rewrite selected text.",

    "permissions": ["contextMenus", "storage", "activeTab"],

    "host_permissions": ["https://humanizex.onrender.com/*"],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_title": "HumanizeX"
    },

    "commands": {
        "detect-selection": {
            "suggested_key": {
                "default": "Ctrl+Shift+X"
            },
            "description": "Run AI detection on the selected text"
        }
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}

